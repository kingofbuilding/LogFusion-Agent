# API 密钥配置模板
# 复制此文件为 .env，并只在 .env 中填入真实 API 密钥。
# 注意：.env 会被 .gitignore 忽略，不要把真实密钥提交到 GitHub。

# DeepSeek API（可选，用于 LLM 中文研判）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Qwen API（可选）
QWEN_API_KEY=your_qwen_api_key_here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# OpenAI API（可选）
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# HuggingFace（可选，用于下载模型）
HF_TOKEN=your_huggingface_token_here

# 数据集下载路径
LOGHUB_URL=https://github.com/logpai/loghub

# 其他配置
DEBUG=False
LOG_LEVEL=INFO

# LogFusion-Agent LLM 工具调用（任选一个支持工具调用的兼容服务）
AGENT_API_KEY=your_agent_api_key_here
AGENT_BASE_URL=https://api.deepseek.com
AGENT_MODEL=deepseek-chat
